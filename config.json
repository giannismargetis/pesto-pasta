{
  "engine": "whisper",
  "language": "auto",
  "hotkey": "right ctrl",
  "toggle_lang_key": "f12",
  "toggle_engine_key": "f11",
  "cancel_key": "esc",
  "beep_enabled": true,
  "overlay_enabled": true,
  "start_minimized": false,
  "run_on_startup": false,
  "partial_chunk_seconds": 2.0,
  "silence_flush_seconds": 0.7,
  "max_recording_seconds": 60,
  "idle_unload_minutes": 15,
  "whisper_model": "large-v3-turbo",
  "whisper_compute_cuda": "int8_float16",
  "whisper_compute_cpu": "int8",
  "whisper_beam_size": 2,
  "whisper_vad_filter": true,
  "parakeet_model": "nemo-parakeet-tdt-0.6b-v3",
  "parakeet_quantization": "int8",
  "parakeet_provider": "",
  "sample_rate": 16000,
  "agent": {
    "enabled": true,
    "model": "decider-2b",
    "model_runtime": "gpu",
    "model_revision": "v11",
    "model_quantization": "Q4_K_M",
    "confidence_threshold": 0.72,
    "confirmation_threshold": 0.55,
    "max_steps": 30,
    "loop_timeout_seconds": 120,
    "max_retries": 2,
    "max_same_state_repeats": 3,
    "allow_shell_commands": true,
    "headless_browser": false
  },
  "permissions": {
    "browser": true,
    "filesystem_read": true,
    "filesystem_write": false,
    "shell": "allowlist",
    "process_termination": false,
    "email_send": false,
    "destructive_actions": "confirm"
  }
}
